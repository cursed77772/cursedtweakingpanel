# ============================================================
# SYSTEM INFORMATION
# ============================================================

function Get-CursedCPUUsage {
    try {
        $cpu = Get-CimInstance Win32_Processor |
            Measure-Object -Property LoadPercentage -Average

        return [math]::Round($cpu.Average, 0)
    }
    catch {
        return 0
    }
}

function Get-CursedRAM {
    try {
        $os = Get-CimInstance Win32_OperatingSystem

        $total = [math]::Round(
            $os.TotalVisibleMemorySize / 1MB,
            1
        )

        $free = [math]::Round(
            $os.FreePhysicalMemory / 1MB,
            1
        )

        $used = [math]::Round(
            $total - $free,
            1
        )

        $percent = if ($total -gt 0) {
            [math]::Round(($used / $total) * 100, 0)
        }
        else {
            0
        }

        return "$used / $total GB ($percent%)"
    }
    catch {
        return "Unavailable"
    }
}

function Get-CursedStorage {
    try {
        $disk = Get-CimInstance Win32_LogicalDisk `
            -Filter "DeviceID='C:'"

        if ($disk) {
            $size = [math]::Round($disk.Size / 1GB, 1)
            $free = [math]::Round($disk.FreeSpace / 1GB, 1)
            $used = [math]::Round($size - $free, 1)

            return "$used / $size GB | $free GB free"
        }
    }
    catch {}

    return "Unavailable"
}

function Get-CursedSystemInfo {

    $computer = Get-CimInstance Win32_ComputerSystem
    $os = Get-CimInstance Win32_OperatingSystem
    $cpu = Get-CimInstance Win32_Processor |
        Select-Object -First 1

    $gpu = Get-CimInstance Win32_VideoController |
        Where-Object {
            $_.Name -and
            $_.Name -notmatch "Microsoft Basic Display"
        } |
        Select-Object -First 1

    $uptime = (Get-Date) - $os.LastBootUpTime

    $admin = if (Test-CursedAdmin) {
        "YES"
    }
    else {
        "NO"
    }

    $cpuName = if ($cpu.Name) {
        $cpu.Name.Trim()
    }
    else {
        "Unknown"
    }

    $gpuName = if ($gpu.Name) {
        $gpu.Name.Trim()
    }
    else {
        "Unknown"
    }

    return @(
        "PC       : $($computer.Name)"
        "USER     : $env:USERNAME"
        "OS       : $($os.Caption)"
        "BUILD    : $($os.BuildNumber)"
        ""
        "CPU      : $cpuName"
        "CPU LOAD : $(Get-CursedCPUUsage)%"
        "GPU      : $gpuName"
        "RAM      : $(Get-CursedRAM)"
        "STORAGE  : $(Get-CursedStorage)"
        ""
        "UPTIME   : $([int]$uptime.TotalDays)d $($uptime.Hours)h $($uptime.Minutes)m"
        "ADMIN    : $admin"
    )
}

# ============================================================
# REGISTRY BACKUP
# ============================================================

function Backup-CursedRegistry {
    param(
        [string]$Name = "CursedBackup"
    )

    $folder = Join-Path $env:USERPROFILE "CursedBackups"

    if (-not (Test-Path $folder)) {
        New-Item -ItemType Directory -Path $folder -Force |
            Out-Null
    }

    $file = Join-Path `
        $folder `
        "$Name-$(Get-Date -Format 'yyyyMMdd-HHmmss').reg"

    reg.exe export `
        "HKCU\Software\Microsoft\Windows\CurrentVersion\Explorer" `
        "$file" `
        /y | Out-Null

    Write-Host ""
    Write-Host "  [+] Registry backup created:" -ForegroundColor White
    Write-Host "      $file" -ForegroundColor DarkGray

    return $file
}

function New-CursedRestorePoint {

    if (-not (Require-Admin)) {
        return
    }

    Write-Host ""
    Write-Host "  Creating Windows restore point..." -ForegroundColor White

    try {
        Checkpoint-Computer `
            -Description "Cursed Utility Backup" `
            -RestorePointType "MODIFY_SETTINGS"

        Write-Host "  [+] Restore point created." -ForegroundColor White
    }
    catch {
        Write-Host "  [-] Could not create restore point." -ForegroundColor White
    }

    Pause-Cursed
}

