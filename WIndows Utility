# ============================================================
# QUICK ACTIONS
# ============================================================

function Invoke-CursedQuickAction {
    param([string]$Action)

    switch ($Action) {

        "DNS" {
            ipconfig /flushdns
            Write-Host "  [+] DNS cache flushed." -ForegroundColor White
        }

        "EXPLORER" {
            Stop-Process -Name explorer -Force
            Start-Process explorer.exe
            Write-Host "  [+] Explorer restarted." -ForegroundColor White
        }

        "RECYCLE" {
            Clear-RecycleBin -Force -ErrorAction SilentlyContinue
            Write-Host "  [+] Recycle Bin emptied." -ForegroundColor White
        }

        "UPDATE" {
            Start-Process "ms-settings:windowsupdate"
        }

        "TASK" {
            Start-Process taskmgr.exe
        }

        "RESMON" {
            Start-Process resmon.exe
        }
    }

    Pause-Cursed
}

