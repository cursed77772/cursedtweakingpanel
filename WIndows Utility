    $path = "HKCU:\Software\Microsoft\GameBar"

    New-Item -Path $path -Force | Out-Null

    New-ItemProperty `
        -Path $path `
        -Name "AutoGameModeEnabled" `
        -PropertyType DWord `
        -Value 1 `
        -Force | Out-Null

    Write-Host ""
    Write-Host "  [+] Windows Game Mode enabled." -ForegroundColor White

    Pause-Cursed
}

